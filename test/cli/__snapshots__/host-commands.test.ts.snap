exports[`host CLI commands > install, doctor, and uninstall adal 1`] = `
"$ tokenjuice doctor adal
[stdout] instructions path: <SANDBOX>/project/AGENTS.md
[stdout] health: disabled
[stdout] issues:
[stdout] - tokenjuice AdaL CLI instructions are not installed
[stdout] advisories:
[stdout] - AdaL CLI support is beta and instruction-based; AdaL reads project AGENTS.md context but still owns command execution.
[stdout] repair: tokenjuice install adal
exit 0

$ tokenjuice install adal
[stdout] success: adal instructions installed successfully

  Instructions: <SANDBOX>/project/AGENTS.md
  Beta        : instruction-based guidance; AdaL CLI still owns command execution
  Verify      : tokenjuice doctor adal
  Escape hatch: tokenjuice wrap --raw -- <command>
exit 0

$ tokenjuice doctor adal
[stdout] instructions path: <SANDBOX>/project/AGENTS.md
[stdout] health: ok
[stdout] advisories:
[stdout] - AdaL CLI support is beta and instruction-based; AdaL reads project AGENTS.md context but still owns command execution.
[stdout] repair: tokenjuice install adal
exit 0

$ tokenjuice doctor adal --format json
[stdout] {
  "instructionsPath": "<SANDBOX>/project/AGENTS.md",
  "status": "ok",
  "issues": [],
  "advisories": [
    "AdaL CLI support is beta and instruction-based; AdaL reads project AGENTS.md context but still owns command execution."
  ],
  "fixCommand": "tokenjuice install adal",
  "checkedPaths": [],
  "missingPaths": []
}
exit 0

$ tokenjuice install adal --format json
[stdout] {
  "instructionsPath": "<SANDBOX>/project/AGENTS.md"
}
exit 0

$ tokenjuice uninstall adal
[stdout] removed adal instructions: yes
[stdout] instructions path: <SANDBOX>/project/AGENTS.md
[stdout] enable: tokenjuice install adal
exit 0

$ tokenjuice uninstall adal --format json
[stdout] {
  "instructionsPath": "<SANDBOX>/project/AGENTS.md",
  "removed": false
}
exit 0

$ tokenjuice doctor adal
[stdout] instructions path: <SANDBOX>/project/AGENTS.md
[stdout] health: disabled
[stdout] issues:
[stdout] - tokenjuice AdaL CLI instructions are not installed
[stdout] advisories:
[stdout] - AdaL CLI support is beta and instruction-based; AdaL reads project AGENTS.md context but still owns command execution.
[stdout] repair: tokenjuice install adal
exit 0
"
`;

